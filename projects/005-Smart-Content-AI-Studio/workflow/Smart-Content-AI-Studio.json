      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        464,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.topic }}",
        "options": {
          "systemMessage": "You are an Arabic-first content strategist. Generate exactly 3 distinct Instagram Reel ideas for the user's topic. For each include a compelling Arabic hook (up to 9 words), concept, 20-second Arabic script, CTA, and short English caption. Target creators and small businesses. Do not guarantee views or sales."
        }
      }
    },
    {
      "id": "6b6050aa-5ae3-4d52-9e40-cdc9b8e77127",
